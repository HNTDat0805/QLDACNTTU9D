# ==============================================================================
# Environment Configuration Template for FixPhone (Frontend)
# Copy file này thành frontend/.env trước khi khởi chạy ứng dụng:
#   cp frontend/.env.example frontend/.env
# ==============================================================================

# Địa chỉ API Backend FastAPI
VITE_API_URL=http://localhost:8000

# Địa chỉ giao diện web Mailpit (kiểm thử email môi trường dev)
MAILPIT_HOST=http://localhost:8025
