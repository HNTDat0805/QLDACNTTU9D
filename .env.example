# ==============================================================================
# Environment Configuration Template for FixPhone (Backend & Services)
# Copy file này thành .env trước khi khởi chạy ứng dụng:
#   cp .env.example .env
# ==============================================================================

# Môi trường chạy ứng dụng: development | production
FASTAPI_ENV=development

# Tên dự án
PROJECT_NAME="FixPhone - Booking & Repair Management System"

# Tên miền Traefik reverse proxy
DOMAIN=localhost

# JWT Secret Key - BẮT BUỘC sinh khóa bí mật ngẫu nhiên tối thiểu 32 ký tự khi triển khai
# Gợi ý sinh key an toàn: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate_a_secure_random_secret_key_here

# Tài khoản Quản trị viên khởi tạo ban đầu (First Superuser)
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace_with_a_secure_password

# Cấu hình Email SMTP (Mặc định local sử dụng Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=False
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
EMAILS_FROM_NAME="FixPhone Support"

# Cấu hình Cơ sở dữ liệu PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_postgres_password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app

# Giám sát Sentry DSN (Tùy chọn)
SENTRY_DSN=
